From 4a1141c0587c18930b51d98c5b4ffe2b6883484a Mon Sep 17 00:00:00 2001
From: "H. Vetinari" <h.vetinari@gmx.com>
Date: Mon, 7 Sep 2026 17:58:36 +0200
Subject: [PATCH 7/8] link libpython3.so explicitly

---
 lldb/cmake/modules/AddLLDB.cmake | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/lldb/cmake/modules/AddLLDB.cmake b/lldb/cmake/modules/AddLLDB.cmake
index daf33e219563..65b66f64d401 100644
--- a/lldb/cmake/modules/AddLLDB.cmake
+++ b/lldb/cmake/modules/AddLLDB.cmake
@@ -170,6 +170,8 @@ function(add_lldb_executable name)
   )
 
   target_link_libraries(${name} PRIVATE ${ARG_LINK_LIBS})
+  target_link_libraries(${name} PRIVATE ${Python3_LIBRARIES})
+  target_link_options(${name} PRIVATE -Wl,--no-as-needed)
   if(WIN32)
     list(FIND ARG_LINK_LIBS liblldb LIBLLDB_INDEX)
     if(NOT LIBLLDB_INDEX EQUAL -1)
